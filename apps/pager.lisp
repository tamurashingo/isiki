;;;; apps/pager.lisp
;;;;
;;;; **ファイルを一面ずつ見せる道具**(issue #215)。
;;;; 調査は docs/investigation/app-terminal-io.{logic,refs}.md。
;;;;
;;;; ## なぜこれが最初のアプリなのか(調査 §11-4)
;;;;
;;;; **新しい組み込みを 1 つも足さずに作れる唯一のアプリ**である。理由 3 つ:
;;;;
;;;;   1. **上から順に書くだけで成立する。** 画面にはカーソルの位置指定が無く、
;;;;      読み出しも消去も外から触る口が一つも無い(調査 §9-7/9-8)。
;;;;      ページャはそれを 1 つも要求しない
;;;;   2. **「改行で次の頁」にすれば、行の確定を待つ既存の読み取りがそのまま使える。**
;;;;      1 キーずつ待つ仕組みは今は無い(調査 §9-1)が、迂回できる
;;;;   3. **書き込みが無い。** 上書き保存の壊れ(調査 §7)に当たらない
;;;;
;;;; ## 置き場所
;;;;
;;;; **アプリ専用の FAT32 ディスク(Makefile の APP_DISK_IMG)の根。**
;;;; apps/hello.lisp と同じ約束で、ホスト側の原本がこの apps/ にあり、
;;;; ビルドがイメージへ焼き込む。ゲストからは
;;;;   (mount "/app" (%device-named "ide-primary-slave") ':fat32)
;;;;   (load "/app/pager.lisp")
;;;;
;;;; **9P の無い起動でも読まれうる**ので、ここに書けるのはカーネルへ同梱した
;;;; 基盤ライブラリと AOT 済みの層だけである(ホスト共有を load してはならない)。
;;;; このファイルが使うのは read-line / preview-char / format / open-input-file と
;;;; init.lisp のマクロだけで、**どれもカーネルの中にある。**
;;;;
;;;; ## 守っていること(issue #215 / 調査)
;;;;
;;;; - **`(format t ...)` を使っていない。** 第 1 引数は MAGIC_STREAM を要求するので
;;;;   `t` では通らない(format.c:164-168 → stream_lisp.c:139)。出力先は常に
;;;;   引数で受け取ったストリームで、薄い皮だけが `(standard-output)` を呼ぶ
;;;; - **桁揃えをしていない。** `~nA` は num が無視されるので桁揃えに使えない
;;;;   (format.c:204-215)。要るのは行をそのまま流すことだけなので、
;;;;   そもそも揃えない形にして罠を避けた
;;;; - **読み取り口は 1 つ持ち回る。** `(standard-input)` は皮の中で 1 回だけ呼び、
;;;;   核へ渡す。呼び直すと毎回 1.6KB 確保するうえ(調査 §8-8)、
;;;;   先読みの 1 文字が捨てられる
;;;; - **頁の高さは自前の動的変数で持つ。画面から読まない。**
;;;;   行数・桁数を Lisp から読む口は無い(調査 §9-7。確認済み)
;;;; - **主ループは関数の中に書く。** トップレベルの繰り返しは 1 反復ごとに
;;;;   再帰的に評価されてスタックを壊す(調査 §8-10)
;;;;
;;;; ## 核と皮を分けた理由(これが設計の要)
;;;;
;;;; 核 `pager-run` は**本文・合図・表示先の 3 つをストリームで受け取る。**
;;;; 文字列入力ストリームを渡せば**キー入力なしで試験できる**。
;;;; 調査は「キーの取り扱いはどの単体試験にもリンクされておらず**全体が無試験**」
;;;; (§9-15)と報告している。対話を直に書くと、その族をもう 1 つ増やすことになる。
;;;; 試験は test/lisp/pager_test.lisp。

;;; ---------------------------------------------------------------------------
;;; 頁の高さ(本文の行数)
;;;
;;; **画面から読まない。** 格子の行数は起動時の解像度から決まる値
;;; (framebuffer.c:439-440 cols = width/8; rows = height/16)で、
;;; **Lisp から読む口が無い**。画面寸法の読み取りは土台のマイルストンの仕事。
;;;
;;; 既定値は控えめにする。**実画面より大きいと行き過ぎる**(頁の頭が履歴へ
;;; 流れてしまう)。20 行 + 合図の 1 行 = 21 行で、過去の記録にある 50 行にも、
;;; それより小さい解像度にも収まる見積もりである ★(実画面の行数は確かめていない)。
;;;
;;; **初期宣言は安全な形で書く**(tools/check_defdynamic_safe.py と同じ作法。#187)。
;;; defdynamic は value-form を評価して**無条件に上書きする**ので、素の初期値を
;;; 書くと「2 回目の load」が利用者の設定を無言で消す。
;;; この `or` の形は **「この変数は nil を意味のある値として持たない」**ことに
;;; 依存している(頁の高さに nil は無い)。その前提が崩れたら書き換えが要る。
(defdynamic *pager-page-lines* (or (dynamic *pager-page-lines*) 20))

;;; ---------------------------------------------------------------------------
;;; 1 面ぶんを出す
;;;
;;; `src` から最大 n 行読んで `out` へ流し、**実際に出した行数**を返す。
;;; ファイルの終端に当たればそこで止まる(返り値が n より小さくなる)。
;;;
;;; 行を貯めない。**一面ぶんずつ読んで出す**ので、巨大なファイルでも
;;; Lisp 側のリストは作らない(行の文字列 1 本ぶんだけが生きる)。
(defun %pager-emit-page (src out n)
  (let ((i 0) (going t))
    (while (and going (< i n))
      (progn
        ;; **eos-error-p を nil にして終端を値で受ける。** 既定は「終端でエラー」
        ;; (stream_lisp.c の resolve_input_args)なので、省略すると
        ;; 最後の頁でいちいち条件を捕まえる形になる
        (let ((line (read-line src nil nil)))
          (if (null line)
              (setq going nil)
            (progn
              (format out "~A~%" line)
              (setq i (+ i 1)))))))
    i))

;;; ---------------------------------------------------------------------------
;;; 合図を待つ
;;;
;;; `in` から 1 行読んで、**続けるか・やめるか**を返す('pager-go / 'pager-quit)。
;;;
;;; **行単位で読むのは、それが今ある唯一の形だから**である。打たれたキーは
;;; 改行が入るまで溜め場に貯まり、**行の確定だけが読み手を起こす**
;;; (調査 §5-11)。したがって「改行で次の頁」は 1 打鍵で動く形に最も近い。
;;;
;;; やめる合図は 2 つ:
;;;   - 入力が尽きた(nil)。**文字列入力ストリームでの打ち切りがこれ**
;;;   - "q" / "Q" の行。**実機の利用者が途中でやめる唯一の手段**
;;;     (画面にも入力にも「脱出キー」が無い。調査 §9-3)
(defun %pager-wait-signal (in)
  (let ((ans (read-line in nil nil)))
    (if (null ans)
        'pager-quit
      (if (or (string= ans "q") (string= ans "Q"))
          'pager-quit
        'pager-go))))

;;; ---------------------------------------------------------------------------
;;; 核。**ここがアプリの全部で、ストリームしか触らない**
;;;
;;;   src … 本文の入力ストリーム
;;;   in  … 次の頁へ進む合図の入力ストリーム
;;;   out … 表示先の出力ストリーム
;;;
;;; 返り値は (理由 出した頁数 出した行数) の 3 つ組:
;;;   'pager-end  … 最後まで出して終わった
;;;   'pager-quit … 途中で打ち切った
;;;
;;; **数を返すのは、試験が「何面出たか」を言えるようにするため**である。
;;; 画面の中身を読み返す手段は無い(調査 §9-9)ので、出力先を文字列ストリームに
;;; したうえで、この 3 つ組と突き合わせる。
;;;
;;; 終端の見分けに `preview-char` を使う。**1 文字先読みして戻すだけ**で消費しない
;;; (stream_lisp.c の cc_preview_char → os_stream_preview_char の先読みスロット)。
;;; これが要るのは**「頁ちょうどのファイル」**のためである: n 行出したあとに
;;; 合図を待ってしまうと、もう何も無いのに利用者を待たせることになる。
(defun pager-run (src in out)
  ;; 高さは**入口で 1 回だけ読む**。頁ごとに読む形にすると、1 回の表示の途中で
  ;; 値が変わりうることを認めてしまい、返す頁数の意味が定まらない
  (let ((n (dynamic *pager-page-lines*))
        (pages 0) (lines 0) (reason 'pager-end) (running t))
    ;; **0 以下を 1 に丸める。** 丸めないと「1 行も出ないのに終端でもない」状態で
    ;; 合図を待ち続ける(終わらないループになる)
    (if (< n 1) (setq n 1) nil)
    (while running
      (progn
        (let ((k (%pager-emit-page src out n)))
          (progn
            (if (> k 0) (setq pages (+ pages 1)) nil)
            (setq lines (+ lines k))
            (if (null (preview-char src nil nil))
                ;; 最後まで出した。**合図を待たない**
                (setq running nil)
              (progn
                ;; 続きがある印。**改行を自分で出さない。**
                ;; 実機では打鍵が割り込みの中で画面へエコーされる(調査 §4-3-10)ので、
                ;; 利用者が押した改行がそのまま行送りになる。ここで ~% を足すと
                ;; 頁の間に空行が 1 行入る ★(エコーの行送りは読みで確かめた範囲)
                (format out "--more-- (~D) " pages)
                (if (eq (%pager-wait-signal in) 'pager-quit)
                    (progn
                      (setq reason 'pager-quit)
                      (setq running nil))
                  nil)))))))
    (list reason pages lines)))

;;; ---------------------------------------------------------------------------
;;; 皮。**これだけが画面とキーボードを知っている**
;;;
;;; `(standard-input)` / `(standard-output)` を**それぞれ 1 回だけ**呼んで核へ渡す。
;;; どちらも未束縛なら新しい流れを作る(= 1 回あたり約 1.6KB の確保。調査 §8-8)ので、
;;; ループの中で呼んではならない。
;;;
;;; パスの契約は load と同じ: **先頭が '/' ならマウント表で解決する**
;;; (open-input-stream → stream_lisp.c:150 os_mount_resolve)。
;;; つまり (pager "/app/pager.lisp") のように書く。
(defun pager (path)
  (with-open-input-file (src path)
    (pager-run src (standard-input) (standard-output))))
