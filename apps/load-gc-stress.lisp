;;;; apps/load-gc-stress.lisp
;;;;
;;;; [M2-T3 / #195 / #196 からの申し送り] **ディスク経由の load が、記憶域の整理を
;;;; 強制しても壊れないことを確かめるための材料。** test/lisp/load_gc_stress_test.lisp
;;;; が (load "/app/load-gc-stress.lisp") で読む。
;;;;
;;;; **題材の形は意図である。** #196 で確かめた再現の条件は厳しい:
;;;;   - **入れ子のリストが要る。** 平らなリストは要素を全部読んでから cons を積むので、
;;;;     読んでいる途中に確保が入らない。入れ子なら内側の cons が先に確保され、
;;;;     **そのあと外側の読み取りが続く**(= 整理を跨いで読み取りが続く窓が開く。
;;;;     src/c/reader.c の read_list / read_list_rest)
;;;;   - **生存集合を膨らませるフォームを間に挟まないと再現しない。**
;;;;     生存集合が小さいと、複製先が古い複製の位置まで届かないので、
;;;;     古い複製を読み続けても中身が壊れず「穴が開いていても気づけない」
;;;;
;;;; 症状は「同じ式が二度評価される」「途中から中身が化ける」で、
;;;; **どちらも load は成功(t)を返す。** したがって戻り値では見分けられず、
;;;; **数えるしかない**(*app-lgs-count* は 1 ファイルで必ず 2 増える)。
;;;;
;;;; 題材は小さく保つこと。%%diag-gc-stress 1(確保ごとに整理)は非常に遅い。
;;;; 変数は読み込む側が先に defglobal してある。

(setq *app-lgs-count* (+ *app-lgs-count* 1))

;; 生存集合を膨らませる(整理のたびに複製される量を増やす)。
;; **この行を抜くと、以後の読み取りが古い複製から進んでも壊れずに通ってしまう**
(setq *app-lgs-live* (list (list 1 2 3) (list 4 5 6) (list 7 8 9)
                           (list 10 11 12) (list 13 14 15)))

;; 入れ子のリスト(読み取りの途中に確保が入る形)
(setq *app-lgs-nested* '((1 2) (3 (4 5)) ((6) 7)))

;; 新しい string の確保を跨ぐ
(setq *app-lgs-strings* (list "alpha" "beta" "gamma"))

(setq *app-lgs-count* (+ *app-lgs-count* 1))
