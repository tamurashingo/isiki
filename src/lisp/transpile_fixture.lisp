(defun %%transpile-fixture-rest (&rest items)
  ;; M14基盤B: &restパラメータのみの検証。全実引数がそのままconsチェーンとして
  ;; itemsへ束縛されることを確認する(呼び出し側のevaluated_args構築自体は
  ;; 固定パラメータの場合と変わらない)
  items)

(defun %%transpile-fixture-rest-with-fixed (a &rest items)
