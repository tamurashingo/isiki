;;;; トランスパイラの動作確認用の最小フィクスチャ(M9時点)
;;;; fixnum/string/symbol/nil/tのリテラルとquote、パラメータ付きdefun、
;;;; if/progn/setq/and/or、パラメータのGC_PROTECT統合、このファイル内での
;;;; 自己/相互再帰呼び出しをサポートする

(defun %%transpile-fixture-answer ()
  42)

(defun %%transpile-fixture-string ()
  "hello")

(defun %%transpile-fixture-symbol ()
  'foo)

(defun %%transpile-fixture-nil ()
  nil)

(defun %%transpile-fixture-t ()
  t)

(defun %%transpile-fixture-quoted-fixnum ()
  '99)

(defun %%transpile-fixture-identity (x)
  x)

(defun %%transpile-fixture-second-param (x y)
  y)

(defun %%transpile-fixture-if (x)
  (if x 1 2))

(defun %%transpile-fixture-if-no-else (x)
  (if x 42))

(defun %%transpile-fixture-progn (x)
  (progn x 99))

(defun %%transpile-fixture-setq (x)
  (setq x 7))

(defun %%transpile-fixture-and (x y)
  (and x y))

(defun %%transpile-fixture-and-empty ()
  (and))

(defun %%transpile-fixture-and-single (x)
  (and x))

(defun %%transpile-fixture-or (x y)
  (or x y))

(defun %%transpile-fixture-or-empty ()
  (or))

(defun %%transpile-fixture-or-single (x)
  (or x))

(defun %%transpile-fixture-or-three (x y z)
  ;; 3引数以上のorで、*or-temp-counter*によるC一時変数名の一意性
  ;; (ネストしたステートメント式の生成)を検証する
  (or x y z))

(defun %%transpile-fixture-gc-protect (x)
  ;; M7: パラメータxのGC_PROTECT統合を検証するためのフィクスチャ。
  ;; bodyの最初の2要素は、それぞれ40000文字のダミー文字列リテラルで、
  ;; os_make_stringで都度ヒープ確保される(値は捨てられ、最後にxを返す)。
  ;; 1つ目は直接確保できるが、2つ目の確保時には(1つ目が既に不要になった後でも)
  ;; 空き領域が足りずbody評価中に実際にos_gc_collectが発火する、というテスト側の
  ;; ヒープサイズ設定を前提にしている。フィラーを2つに分けているのは、
  ;; 「GCが発火する」条件と「発火後に確保が成功する」条件を分離するためで、
  ;; GC後の生存領域はbootstrap分+xの小さい文字列のみになるため、ヒープサイズの
  ;; 安全マージンを広く取れる(1つのフィラーだけだとGC発火直前の空き容量と
  ;; フィラー自体のサイズの引きがほぼ一致してしまい、境界がわずか十数バイトしかない)。
  ;; xがGC_PROTECTされていれば、この内部GCでxの指す先(ヒープオブジェクト)が
  ;; 移動しても正しく追従できる
  (progn "" "" x))

(defun %%transpile-fixture-count-down (n)
  ;; M9: 自己再帰の検証。nを1ずつ減らしながら(- n 1)で再帰し、eqでnが0になった
  ;; ことを検出して停止する。呼び出し先(このファイル内で自分自身)が定義順に
  ;; 関わらず解決できることを検証する
  (if (eq n 0) 42 (%%transpile-fixture-count-down (- n 1))))

(defun %%transpile-fixture-is-even (n)
  ;; M9: 相互再帰の検証。is-evenがまだ定義されていないis-oddを先に呼び出す形に
  ;; なるが、mainがbody生成前に全defun名を*known-function-names*へ収集して
  ;; いるため、定義順に関わらずcall-target-c-nameが解決できる
  (if (eq n 0) t (%%transpile-fixture-is-odd (- n 1))))

(defun %%transpile-fixture-is-odd (n)
  (if (eq n 0) nil (%%transpile-fixture-is-even (- n 1))))
